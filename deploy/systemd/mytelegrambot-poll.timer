[Unit]
Description=Poll Telegram for inbound bot commands every minute
Documentation=https://github.com/MyThingsLab/my-telegram-bot

[Timer]
# First run a minute after boot, then once a minute thereafter. Polling itself
# is cheap (one getUpdates); only an actual /idea message costs an Engine call.
OnBootSec=1min
OnUnitActiveSec=1min
# A oneshot won't be re-activated while the previous run is still going (e.g.
# mid-/idea explore), so poll runs never overlap -- the next just waits its turn.
Persistent=true

[Install]
WantedBy=timers.target
