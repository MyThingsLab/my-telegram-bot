[Unit]
Description=Poll Telegram for inbound MyThingsLab bot commands (/idea, /help)
Documentation=https://github.com/MyThingsLab/my-telegram-bot
After=network-online.target
Wants=network-online.target
# Ping the owner over Telegram if a poll run fails (shared fleet template,
# same as fleet-usage / fleet-cycle).
OnFailure=telegram-alert@%n.service

[Service]
Type=oneshot
User=lollinuxpi
WorkingDirectory=/home/lollinuxpi/repos/MyThingsLab/my-telegram-bot
# venv first so `mytelegrambot` resolves; /usr/bin supplies `gh` and `claude`
# for the /idea path (file_idea shells out to gh, explore to the Claude CLI).
Environment=PATH=/home/lollinuxpi/repos/MyThingsLab/.venv/bin:/usr/bin:/bin
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID. Leading - => optional, so a missing
# file doesn't fail the unit (poll then no-ops with an env KeyError, harmless).
EnvironmentFile=-/home/lollinuxpi/.config/mythingslab/telegram.env
# The poll cursor (last_update_id) plus any ask/notify entries land in this
# repo's own ledger, resolved relative to WorkingDirectory above.
ExecStart=/home/lollinuxpi/repos/MyThingsLab/.venv/bin/mytelegrambot poll
# A wedged getUpdates or a slow /idea Engine call must not hang the timer
# forever; systemd kills and reports (OnFailure) past this bound.
TimeoutStartSec=300
